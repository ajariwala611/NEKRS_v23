static dfloat U_inf;
static dfloat AoA;
static dfloat mu;
static dfloat rho;
static dfloat nu;
static dfloat AoA_rad;
static dfloat tdamp, rota;
static dfloat sposx, sposy, sposz;
static dfloat eposx, eposy, eposz;
static dfloat smthx, smthy;
static dfloat Lz;
static int nmode;
static dfloat tdt;

static dfloat avg_time;
static dfloat stat_dump_freq;
static int Nz;

static std::vector<double> phase_current; // For h_i(z), size nmode
static std::vector<double> phase_next;    // For h_{i+1}(z), size nmode
static occa::memory o_phase_curr;
static occa::memory o_phase_next;
static int last_harmonic_index = -1;
static std::mt19937_64 rng(12345); // seed once (or seed per run)
static std::uniform_real_distribution<double> U01(0.0, 1.0);

static dfloat *dragvx, *dragvy, *dragvz;
static occa::memory o_dragvx, o_dragvy, o_dragvz;
static dfloat *dragpx, *dragpy, *dragpz;
static occa::memory o_dragpx, o_dragpy, o_dragpz;

static occa::memory o_interp_u, o_interp_v, o_interp_w;
static occa::memory o_interp_u2, o_interp_v2, o_interp_w2;
static occa::memory o_interp_uv, o_interp_vw, o_interp_wu;
static pointInterpolation_t *normInterpolator = nullptr;
static int interp_np = 0;
static std::vector<dfloat> interp_loc_x, interp_loc_y, interp_loc_z;


// Reads x,y from file and replicates points across Nz planes to fill x,y,z.
void readGridFileMultiZ(const std::string &filename,
                        std::vector<dfloat> &x,
                        std::vector<dfloat> &y,
                        std::vector<dfloat> &z,
                        int mpiRank,
                        int Nz,
                        dfloat Lz)
{
  x.clear();
  y.clear();
  z.clear();

  if (mpiRank != 0) {
    // Non-root ranks: do nothing
    return;
  }

  if (Nz <= 0) {
    std::cerr << "readGridFileMultiZ: Nz must be > 0\n";
    return;
  }

  std::ifstream infile(filename);
  if (!infile.is_open()) {
    std::cerr << "Error opening file: " << filename << std::endl;
    return;
  }

  // Build z-planes: midpoint rule avoids sampling exactly at periodic boundaries
  std::vector<dfloat> zlist(Nz);
  for (int j = 0; j < Nz; ++j) {
    zlist[j] = ( (dfloat)j + 0.5 ) * (Lz / (dfloat)Nz);
  }

  std::string line;
  int np_xy = 0;

  // Read number of (x,y) points (first line)
  if (std::getline(infile, line)) {
    std::istringstream iss(line);
    iss >> np_xy;
  }

  // Reserve total points replicated across Nz planes
  const std::size_t np_total = (std::size_t)np_xy * (std::size_t)Nz;
  x.reserve(np_total);
  y.reserve(np_total);
  z.reserve(np_total);

  // Read x,y and replicate over zlist
  int count_xy = 0;
  while (std::getline(infile, line)) {
    std::istringstream iss(line);
    dfloat xi, yi;
    if (iss >> xi >> yi) {
      ++count_xy;

      for (int j = 0; j < Nz; ++j) {
        x.push_back(xi);
        y.push_back(yi);
        z.push_back(zlist[j]);
      }
    }
  }

  // Optional sanity warning if file count doesn't match header
  if (np_xy > 0 && count_xy != np_xy) {
    std::cerr << "readGridFileMultiZ warning: header np=" << np_xy
              << " but read " << count_xy << " (x,y) points\n";
  }
}


static inline dfloat safeSqrt(dfloat x) {
  return std::sqrt(std::max<dfloat>(x, 0));
}

void writeNormalsMonitor(const std::string &filename, dfloat time,
                         const std::vector<dfloat> &stations, int Np, int Nz,
                         const std::vector<dfloat> &x,
                         const std::vector<dfloat> &y,
                         const std::vector<dfloat> &Umean,
                         const std::vector<dfloat> &Vmean,
                         const std::vector<dfloat> &Wmean,
                         const std::vector<dfloat> &U2mean,
                         const std::vector<dfloat> &V2mean,
                         const std::vector<dfloat> &W2mean,
                         const std::vector<dfloat> &UVmean,
                         const std::vector<dfloat> &VWmean,
                         const std::vector<dfloat> &WUmean)
{
  const int Ns = (int)stations.size();
  const int NpTot = Np * Nz;

  std::ofstream out(filename, std::ios::out | std::ios::trunc);
  out << std::scientific << std::setprecision(6);

  const dfloat invNz = 1.0 / (dfloat)Nz;

  for (int i = 0; i < Ns; ++i) {

    // base offset for this station in the 3D (Np*Nz) arrays
    const std::size_t base3 = (std::size_t)i * (std::size_t)NpTot;

    // helper: pointer to first z-sample for (i,k)
    auto pbase = [&](int k) -> std::size_t {
      return base3 + (std::size_t)k * (std::size_t)Nz;
    };

    // helper: span-average any field at (i,k)
    auto zavg = [&](const std::vector<dfloat> &a, int k) -> dfloat {
      const std::size_t b = pbase(k);
      dfloat s = 0;
      for (int j = 0; j < Nz; ++j) s += a[b + (std::size_t)j];
      return s * invNz;
    };

    // x,y are replicated across z; just take j=0 for geometry
    auto xk = [&](int k) -> dfloat { return x[pbase(k)]; };
    auto yk = [&](int k) -> dfloat { return y[pbase(k)]; };

    // Estimate normal from first two points (geometry only)
    dfloat nx = xk(1) - xk(0);
    dfloat ny = yk(1) - yk(0);
    dfloat nrm = std::sqrt(nx*nx + ny*ny);
    nx /= nrm; ny /= nrm;

    dfloat tx = -ny;
    dfloat ty =  nx;
    if (tx < 0) { tx = -tx; ty = -ty; } // keep chordwise-ish sign convention

    auto ydist = [&](int k) {
      return (xk(k) - xk(0))*nx + (yk(k) - yk(0))*ny;
    };

    // ---- compute tau_w from span-averaged mean profile ----
    const dfloat y1 = ydist(1);
    const dfloat y2 = ydist(2);

    const dfloat Um1 = zavg(Umean, 1);
    const dfloat Vm1 = zavg(Vmean, 1);
    const dfloat Um2 = zavg(Umean, 2);
    const dfloat Vm2 = zavg(Vmean, 2);

    const dfloat ut1 = Um1*tx + Vm1*ty;
    const dfloat ut2 = Um2*tx + Vm2*ty;

    dfloat tauw = 0.0, utau = 0.0;
    if (y1 > 0 && y2 > y1) {
      const dfloat b = y2 / (y1 * (y2 - y1));
      const dfloat c = -y1 / (y2 * (y2 - y1));
      const dfloat dutdn = b*ut1 + c*ut2;  // u0=0 enforced implicitly
      tauw = mu * dutdn;
      utau = std::sqrt(std::abs(tauw) / rho);
    }

    printf("time = %15.8e x/c = %5.2f: tau_w = %15.8e u_tau = %15.8e\n",
           time, stations[i], tauw, utau);

    // ----- headers -----
    out << "\n==================================================================\n";
    out << "# time = " << time << "\n";
    out << "# x/c = " << stations[i] << "   tau_w = " << tauw
        << "   u_tau = " << utau << "\n";
    out << "==================================================================\n";

    out << std::setw(4)  << "k"
        << std::setw(15) << "y"
        << std::setw(15) << "Umean"
        << std::setw(15) << "Vmean"
        << std::setw(15) << "ut"
        << std::setw(15) << "vn"
        << std::setw(15) << "y+"
        << std::setw(15) << "U+"
        << std::setw(15) << "V+"
        << std::setw(15) << "W+"
        << std::setw(15) << "uu+"
        << std::setw(15) << "vv+"
        << std::setw(15) << "ww+"
        << "\n";

    out << "-------------------------------------------------------------------\n";

    // ----- rows (still Np rows) -----
    const dfloat utau2 = utau * utau;

    for (int k = 0; k < Np; ++k) {

      // span-averaged means at this (i,k)
      const dfloat Um = zavg(Umean, k);
      const dfloat Vm = zavg(Vmean, k);
      const dfloat Wm = zavg(Wmean, k);

      // projections
      const dfloat ut = Um*tx + Vm*ty;
      const dfloat un = Um*nx + Vm*ny;

      const dfloat ydist_k = std::max<dfloat>(ydist(k), 0);

      // wall units
      const dfloat yplus   = (utau > 0) ? (utau * ydist_k / nu) : 0;
      const dfloat ut_plus = (utau > 0) ? (ut / utau) : 0;
      const dfloat un_plus = (utau > 0) ? (un / utau) : 0;
      const dfloat w_plus  = (utau > 0) ? (Wm / utau) : 0;

      // span-averaged second moments/cross moments
      const dfloat U2m = zavg(U2mean, k);
      const dfloat V2m = zavg(V2mean, k);
      const dfloat W2m = zavg(W2mean, k);
      const dfloat UVm = zavg(UVmean, k);
      // VWm/WUm not used for (t,n) in x-y plane; keep if you later rotate fully 3D
      // const dfloat VWm = zavg(VWmean, k);
      // const dfloat WUm = zavg(WUmean, k);

      // Reynolds stresses in global Cartesian (fluctuating products)
      dfloat uu = U2m - Um*Um;
      dfloat vv = V2m - Vm*Vm;
      dfloat ww = W2m - Wm*Wm;
      dfloat uv = UVm - Um*Vm;

      uu = (uu > 0 ? uu : 0);
      vv = (vv > 0 ? vv : 0);
      ww = (ww > 0 ? ww : 0);

      // rotate to local (t,n) in x-y plane
      dfloat utt = tx*tx*uu + 2*tx*ty*uv + ty*ty*vv; // <u_t'^2>
      dfloat unn = nx*nx*uu + 2*nx*ny*uv + ny*ny*vv; // <u_n'^2>
      dfloat uww = ww;                               // <w'^2>

      utt = (utt > 0 ? utt : 0);
      unn = (unn > 0 ? unn : 0);
      uww = (uww > 0 ? uww : 0);

      const dfloat uu_plus = (utau2 > 0) ? (utt / utau2) : 0;
      const dfloat vv_plus = (utau2 > 0) ? (unn / utau2) : 0;
      const dfloat ww_plus = (utau2 > 0) ? (uww / utau2) : 0;

      out << std::setw(4)  << k
          << std::setw(15) << ydist_k
          << std::setw(15) << Um
          << std::setw(15) << Vm
          << std::setw(15) << ut
          << std::setw(15) << un
          << std::setw(15) << yplus
          << std::setw(15) << ut_plus
          << std::setw(15) << un_plus
          << std::setw(15) << w_plus
          << std::setw(15) << uu_plus
          << std::setw(15) << vv_plus
          << std::setw(15) << ww_plus
          << "\n";
    }
  }

  out.flush();
}

void interpolateNormalPts(nrs_t *nrs, dfloat time, occa::memory o_Uavg, occa::memory o_Urms, occa::memory o_Urm2) {

  // Interpolate velocity
  const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
  occa::memory o_mean_u = o_Uavg.slice(0 * fieldOffsetByte, fieldOffsetByte);
  occa::memory o_mean_v = o_Uavg.slice(1 * fieldOffsetByte, fieldOffsetByte);
  occa::memory o_mean_w = o_Uavg.slice(2 * fieldOffsetByte, fieldOffsetByte);

  normInterpolator->eval(1, nrs->fieldOffset, o_mean_u, interp_np, o_interp_u);
  normInterpolator->eval(1, nrs->fieldOffset, o_mean_v, interp_np, o_interp_v);
  normInterpolator->eval(1, nrs->fieldOffset, o_mean_w, interp_np, o_interp_w);

  occa::memory o_mean_u2 = o_Urms.slice(0 * fieldOffsetByte, fieldOffsetByte);
  occa::memory o_mean_v2 = o_Urms.slice(1 * fieldOffsetByte, fieldOffsetByte);
  occa::memory o_mean_w2 = o_Urms.slice(2 * fieldOffsetByte, fieldOffsetByte);

  normInterpolator->eval(1, nrs->fieldOffset, o_mean_u2, interp_np, o_interp_u2);
  normInterpolator->eval(1, nrs->fieldOffset, o_mean_v2, interp_np, o_interp_v2);
  normInterpolator->eval(1, nrs->fieldOffset, o_mean_w2, interp_np, o_interp_w2);

  occa::memory o_mean_uv = o_Urm2.slice(0 * fieldOffsetByte, fieldOffsetByte);
  occa::memory o_mean_vw = o_Urm2.slice(1 * fieldOffsetByte, fieldOffsetByte);
  occa::memory o_mean_wu = o_Urm2.slice(2 * fieldOffsetByte, fieldOffsetByte);

  normInterpolator->eval(1, nrs->fieldOffset, o_mean_uv, interp_np, o_interp_uv);
  normInterpolator->eval(1, nrs->fieldOffset, o_mean_vw, interp_np, o_interp_vw);
  normInterpolator->eval(1, nrs->fieldOffset, o_mean_wu, interp_np, o_interp_wu);

  if (platform->comm.mpiRank == 0) {
    std::vector<dfloat> interp_u(interp_np), interp_v(interp_np), interp_w(interp_np);
    std::vector<dfloat> interp_u2(interp_np), interp_v2(interp_np), interp_w2(interp_np);
    std::vector<dfloat> interp_uv(interp_np), interp_vw(interp_np), interp_wu(interp_np);
    o_interp_u.copyTo(interp_u.data());
    o_interp_v.copyTo(interp_v.data());
    o_interp_w.copyTo(interp_w.data());
    o_interp_u2.copyTo(interp_u2.data());
    o_interp_v2.copyTo(interp_v2.data());
    o_interp_w2.copyTo(interp_w2.data());
    o_interp_uv.copyTo(interp_uv.data());
    o_interp_vw.copyTo(interp_vw.data());
    o_interp_wu.copyTo(interp_wu.data());
    const int Ns = 10;
    const int Np = 100;
    std::vector<dfloat> stations(Ns);
    for (int i = 0; i < Ns; ++i)
      stations[i] = 0.1 + (1.0 - 0.1) * (dfloat)i / (dfloat)(Ns - 1);

    writeNormalsMonitor("normal_mean_statistic_prof.txt", time, stations, Np, Nz,
                        interp_loc_x, interp_loc_y, 
                        interp_u, interp_v, interp_w,
                        interp_u2,interp_v2,interp_w2,
                        interp_uv,interp_vw,interp_wu);
  }
}

void compute_dump_stats(nrs_t *nrs, dfloat time) {
  static bool initialized = false;
  static occa::memory o_Uavg;
  static occa::memory o_Urms;
  static occa::memory o_Urm2;
  static dfloat last_dump_time;

  if (!initialized) {
    if (!normInterpolator) {
      readGridFileMultiZ("NACA4412_normals_ravel.txt", interp_loc_x, interp_loc_y,
                   interp_loc_z, platform->comm.mpiRank, Nz, Lz);
      interp_np = interp_loc_x.size();
      o_interp_u = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_v = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_w = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_u2 = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_v2 = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_w2 = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_uv = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_vw = platform->device.malloc(interp_np, sizeof(dfloat));
      o_interp_wu = platform->device.malloc(interp_np, sizeof(dfloat));
      normInterpolator = new pointInterpolation_t(nrs);
      normInterpolator->setPoints(interp_np, interp_loc_x.data(),
                                  interp_loc_y.data(), interp_loc_z.data());
      normInterpolator->find();
    }
    last_dump_time = time + stat_dump_freq;
    initialized = true;
  }
  if (time >= last_dump_time) {
    o_Uavg = tavg::get_o_Uavg();
    o_Urms = tavg::get_o_Urms();
    o_Urm2 = tavg::get_o_Urm2();
    interpolateNormalPts(nrs, time, o_Uavg, o_Urms, o_Urm2);
    last_dump_time += stat_dump_freq;
  }
}

struct Force {
  dfloat x;
  dfloat y;
  dfloat z;
};

/* Viscous Drag and Pressure Drag */
Force compute_dragv(nrs_t *nrs, int nbID, const occa::memory &o_bID,
                    occa::memory &o_Sij, const dfloat scale) {
  mesh_t *mesh = nrs->meshV;
  Force dragv;

  if (o_dragvx.size() == 0) {
    dragvx = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragvy = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragvz = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    o_dragvx = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragvy = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragvz = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
  }

  dragvKernel(mesh->Nelements, nrs->fieldOffset, nbID, o_bID, mesh->o_sgeo,
              mesh->o_vmapM, mesh->o_EToB, nrs->o_mue, o_Sij, o_dragvx,
              o_dragvy, o_dragvz);

  o_dragvx.copyTo(dragvx);
  o_dragvy.copyTo(dragvy);
  o_dragvz.copyTo(dragvz);

  dragv.x = 0.0;
  dragv.y = 0.0;
  dragv.z = 0.0;
  for (dlong i = 0; i < mesh->Nelements; i++) {
    dragv.x += dragvx[i];
    dragv.y += dragvy[i];
    dragv.z += dragvz[i];
  }
  MPI_Allreduce(MPI_IN_PLACE, &dragv.x, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragv.y, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragv.z, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  dragv.x *= scale;
  dragv.y *= scale;
  dragv.z *= scale;

  return dragv;
}

Force compute_dragp(nrs_t *nrs, int nbID, const occa::memory &o_bID,
                    occa::memory &o_P, const dfloat scale) {
  mesh_t *mesh = nrs->meshV;
  Force dragp;

  if (o_dragpx.size() == 0) {
    dragpx = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragpy = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragpz = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    o_dragpx = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragpy = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragpz = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
  }

  dragpKernel(mesh->Nelements, nrs->fieldOffset, nbID, o_bID, mesh->o_sgeo,
              mesh->o_vmapM, mesh->o_EToB, o_P, o_dragpx, o_dragpy, o_dragpz);

  o_dragpx.copyTo(dragpx);
  o_dragpy.copyTo(dragpy);
  o_dragpz.copyTo(dragpz);

  dragp.x = 0.0;
  dragp.y = 0.0;
  dragp.z = 0.0;
  for (dlong i = 0; i < mesh->Nelements; i++) {
    dragp.x += dragpx[i];
    dragp.y += dragpy[i];
    dragp.z += dragpz[i];
  }
  MPI_Allreduce(MPI_IN_PLACE, &dragp.x, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragp.y, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragp.z, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  dragp.x *= scale;
  dragp.y *= scale;
  dragp.z *= scale;

  return dragp;
}

void UDF_LoadKernels(occa::properties &kernelInfo) {
  kernelInfo["defines/p_U_inf"] = U_inf;
  kernelInfo["defines/p_AoA"] = AoA;
  kernelInfo["defines/p_pi"] = M_PI;
}

void randomize_modes(std::vector<double> &phases) {
  for (int n = 0; n < nmode; ++n) {
    phases[n] = 2.0 * M_PI * U01(rng);
  }
}

inline double eval_h_theta_phased(const double theta,
                                  const std::vector<double> &phases) {
  double s = 0.0;
  for (int n = 0; n < nmode; ++n) {
    s += std::sin(n * theta + phases[n]);
  }
  return s;
}

/* UDF Functions */

void generate_tripping_forces(nrs_t *nrs, dfloat time, occa::memory o_FU) {
  auto *mesh = nrs->meshV;
  const int Np = mesh->Nlocal;
  const double Tu = tdamp;
  const double t_s = tdt;
  const double alpha = rota;
  const double x0 = sposx, y0 = sposy;
  const double z0 = sposz, z1 = eposz;

  // hoisted constants
  const double ca = std::cos(alpha);
  const double sa = std::sin(alpha);
  const double invSmx = 1.0 / smthx;
  const double invSmy = 1.0 / smthy;
  const double invLz = 1.0 / Lz;

  // time blending
  const int i = (int)std::floor(time / t_s);
  const double p = (time / t_s) - i;
  const double bt = (3.0 - 2.0 * p) * p * p; // 3p^2 - 2p^3

  if (i != last_harmonic_index) {
    // phase_current <- phase_next (device-to-device copy)
    o_phase_curr.copyFrom(o_phase_next, nmode * sizeof(dfloat));
    // phase_next <- new random (host -> device)
    if (platform->comm.mpiRank == 0)
      randomize_modes(phase_next);
    MPI_Bcast(phase_next.data(), nmode, MPI_DFLOAT, 0, platform->comm.mpiComm);
    o_phase_next.copyFrom(phase_next.data(), nmode * sizeof(dfloat));
    last_harmonic_index = i;
  }

  fill_FU(mesh->Nlocal, nrs->fieldOffset, mesh->o_x, mesh->o_y, mesh->o_z, x0,
          y0, z0, z1, invSmx, invSmy, invLz, ca, sa, o_phase_curr, o_phase_next,
          nmode, Tu, bt, o_FU);

  if (nrs->isOutputStep) {
    const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
    auto o_FUy = nrs->o_FU.slice(1 * fieldOffsetByte, fieldOffsetByte);
    auto o_S3 = nrs->cds->o_S.slice(3 * fieldOffsetByte, fieldOffsetByte);
    o_S3.copyFrom(o_FUy);
  }
}

void userf(nrs_t *nrs, dfloat time, occa::memory o_U, occa::memory o_FU) {
  // auto mesh = nrs->meshV;
  generate_tripping_forces(nrs, time, o_FU);
}

void UDF_Setup0(MPI_Comm comm, setupAide &options) {

  platform->par->extract("casedata", "U_inf", U_inf);
  platform->par->extract("casedata", "AoA", AoA);

  platform->par->extract("casedata", "TDAMP", tdamp);
  platform->par->extract("casedata", "SPOSX", sposx);
  platform->par->extract("casedata", "SPOSY", sposy);
  platform->par->extract("casedata", "SPOSZ", sposz);
  platform->par->extract("casedata", "EPOSX", eposx);
  platform->par->extract("casedata", "EPOSY", eposy);
  platform->par->extract("casedata", "EPOSZ", eposz);
  platform->par->extract("casedata", "SMTHX", smthx);
  platform->par->extract("casedata", "SMTHY", smthy);
  platform->par->extract("casedata", "ROTA", rota);
  platform->par->extract("casedata", "NMODE", nmode);
  platform->par->extract("casedata", "TDT", tdt);

  platform->par->extract("casedata", "avg_time", avg_time);
  platform->par->extract("casedata", "stat_dump_freq", stat_dump_freq);
  platform->par->extract("casedata", "Nz", Nz);

  *((double *)nek::scPtr(1)) = U_inf;
  *((double *)nek::scPtr(2)) = AoA;

  platform->options.getArgs("VISCOSITY", mu);
  platform->options.getArgs("DENSITY", rho);
  nu = mu / rho;
}

void UDF_Setup(nrs_t *nrs) {
  mesh_t *mesh = nrs->meshV;
  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    for (int i = 0; i < mesh->Nlocal; ++i) {
      nrs->U[i + 0 * nrs->fieldOffset] = U_inf * cos(AoA * M_PI / 180.0);
      nrs->U[i + 1 * nrs->fieldOffset] = U_inf * sin(AoA * M_PI / 180.0);
      nrs->U[i + 2 * nrs->fieldOffset] = 0.0;
    }
  }
  Lz = std::abs(eposz - sposz);
  AoA_rad = AoA * M_PI / 180.0;
  phase_current.resize(nmode, 0.0);
  phase_next.resize(nmode, 0.0);
  if (platform->comm.mpiRank == 0) {
    randomize_modes(phase_current);
    randomize_modes(phase_next);
  }
  MPI_Bcast(phase_current.data(), nmode, MPI_DFLOAT, 0, platform->comm.mpiComm);
  MPI_Bcast(phase_next.data(), nmode, MPI_DFLOAT, 0, platform->comm.mpiComm);

  o_phase_curr = platform->device.malloc(nmode, sizeof(dfloat));
  o_phase_next = platform->device.malloc(nmode, sizeof(dfloat));
  o_phase_curr.copyFrom(phase_current.data());
  o_phase_next.copyFrom(phase_next.data());

  udf.uEqnSource = &userf;

  // Time averaging setup
  tavg::setup(nrs);

}

void UDF_ExecuteStep(nrs_t *nrs, dfloat time, int tstep) {
  // compute drag
  std::vector<int> bidWall = {3};
  occa::memory o_bidWall =
      platform->device.malloc(bidWall.size() * sizeof(int), bidWall.data());

  // C = F/(.5 rho U^2 * A) = 2*F, A=c*Lz, rho=1, U=U_inf
  const dfloat scale = 1.0;
  auto o_Sij = platform->device.malloc(2 * nrs->NVfields * nrs->fieldOffset,
                                       sizeof(dfloat));
  postProcessing::strainRate(nrs, true, o_Sij); // "false" is correct

  Force dragv = compute_dragv(nrs, bidWall.size(), o_bidWall, o_Sij, scale);
  Force dragp = compute_dragp(nrs, bidWall.size(), o_bidWall, nrs->o_P, scale);
  o_Sij.free();

  Force drag;
  drag.x = dragp.x + dragv.x;
  drag.y = dragp.y + dragv.y;
  drag.z = dragp.z + dragv.z;

  double F_drag = drag.x * cos(AoA_rad) + drag.y * sin(AoA_rad);
  double F_lift = -drag.x * sin(AoA_rad) + drag.y * cos(AoA_rad);

  double Cd = F_drag / (0.5 * Lz);
  double Cl = F_lift / (0.5 * Lz);

  if (platform->comm.mpiRank == 0) {

    std::ofstream drag_file("drag.txt", std::ios::app);
    std::ofstream lift_file("lift.txt", std::ios::app);
    std::ofstream dragz_file("dragz.txt", std::ios::app);
    std::ofstream forces_file("forces.txt", std::ios::app);

    printf("%d %15.8e %15.8e %15.8e %15.8e dragx(rs)\n", tstep, time, drag.x,
           dragp.x, dragv.x);
    printf("%d %15.8e %15.8e %15.8e %15.8e dragy(rs)\n", tstep, time, drag.y,
           dragp.y, dragv.y);
    printf("%d %15.8e %15.8e %15.8e %15.8e dragz(rs)\n", tstep, time, drag.z,
           dragp.z, dragv.z);
    printf("%d %15.8e %15.8e %15.8e %15.8e %15.8e \n", tstep, time, F_drag,
           F_lift, Cd, Cl);

    // Set field width and precision
    const int width_int = 6;    // for tstep
    const int width_float = 15; // for floating point numbers

    // Write drag.txt
    if (drag_file.is_open()) {
      drag_file << std::setw(width_int) << tstep << " "
                << std::setw(width_float) << std::setprecision(8)
                << std::scientific << time << " " << std::setw(width_float)
                << drag.x << " " << std::setw(width_float) << dragp.x << " "
                << std::setw(width_float) << dragv.x << "\n";
      drag_file.close();
    }

    // Write lift.txt
    if (lift_file.is_open()) {
      lift_file << std::setw(width_int) << tstep << " "
                << std::setw(width_float) << std::setprecision(8)
                << std::scientific << time << " " << std::setw(width_float)
                << drag.y << " " << std::setw(width_float) << dragp.y << " "
                << std::setw(width_float) << dragv.y << "\n";
      lift_file.close();
    }

    // Write dragz.txt
    if (dragz_file.is_open()) {
      dragz_file << std::setw(width_int) << tstep << " "
                 << std::setw(width_float) << std::setprecision(8)
                 << std::scientific << time << " " << std::setw(width_float)
                 << drag.z << " " << std::setw(width_float) << dragp.z << " "
                 << std::setw(width_float) << dragv.z << "\n";
      dragz_file.close();
    }

    // Write forces.txt
    if (forces_file.is_open()) {
      forces_file << std::setw(width_int) << tstep << " "
                  << std::setw(width_float) << std::setprecision(8)
                  << std::scientific << time << " " << std::setw(width_float)
                  << F_drag << " " << std::setw(width_float) << F_lift << " "
                  << std::setw(width_float) << Cd << " "
                  << std::setw(width_float) << Cl << "\n";
      forces_file.close();
    }
  }

  if (time > avg_time) {
    tavg::run(time);
    compute_dump_stats(nrs, time);
  }

  if (nrs->isOutputStep) {
    const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
    auto o_S0 = nrs->cds->o_S.slice(0 * fieldOffsetByte, fieldOffsetByte);
    postProcessing::Qcriterion(nrs, o_S0);

    occa::memory o_Uavg = tavg::get_o_Uavg();

    auto o_S1 = nrs->cds->o_S.slice(1 * fieldOffsetByte, fieldOffsetByte);
    occa::memory o_mean_vx = o_Uavg.slice(0 * fieldOffsetByte, fieldOffsetByte);
    o_mean_vx.copyTo(o_S1);

    auto o_S2 = nrs->cds->o_S.slice(2 * fieldOffsetByte, fieldOffsetByte);
    occa::memory o_mean_vy = o_Uavg.slice(1 * fieldOffsetByte, fieldOffsetByte);
    o_mean_vy.copyTo(o_S2);
  }
}
