#
# nek parameter file
#
[OCCA]
backend = CUDA
deviceNumber = LOCAL-RANK

[GENERAL]
#verbose = true
startFrom = "Re_400k_trip_t_18.5.restart+time=0.0"
polynomialOrder = 7
subCyclingSteps = 1
stopAt =  endTime #numSteps#endTime
endTime = 5.0

dt = 2.5e-5
# dt = targetCFL=3.5 + max=2.5e-5
timeStepper = tombo2

writeControl = simulationTime 
writeInterval = 0.5

regularization = hpfrt + nModes=1 + scalingCoeff=10

[MESH]
writeToFieldFile = true
# connectivityTol = 1.0

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
boundaryTypeMap = codedFixedValue,fixedGradient,zeroValue,codedFixedValue,fixedGradient,none,none
viscosity = 1/400000
density = 1.0
residualTol = 1e-06

[SCALAR00] # Jet force field
solver = none

[SCALAR01] # <U>
solver = none

[SCALAR02] # <V>
solver = none

[SCALAR03] # Tripping Forces
solver = none

[SCALAR04] # <P>
solver = none

[CASEDATA]
U_inf = 1.0    # Freestream velocity.
AoA = 11.0     # Angle of attack in degrees.
TDAMP = 5.0         # Time dependent amplitude
SPOSX = 0.0197        # Starting pont X
SPOSY = 0.0302         # Starting pont Y
SPOSZ = 0.0        # Starting pont Z
EPOSX = 0.0197         # Ending pont X
EPOSY = 0.0302       # Ending pont Y
EPOSZ = 0.1        # Ending pont Z
SMTHX = 0.005        # Smoothing length X
SMTHY = 0.001        # Smoothing length Y
ROTA  = 0.625        # Rotation angle in radians
NMODE = 64		              # Number of Fourier modes
TDT = 0.005	      # Time step for tripping
avg_time = 0.0      # time after which averaging start in absolute units
stat_dump_freq = 0.1 # dump stat every t sim time
Nz = 40             # number of station in spanwise direction for span Avg.
jet_xc = 0.6        # Jet x centroid loc
jet_yc = 0.081      # Jet y centroid loc
jet_zc = 0.05       # Jet z centroid loc
jet_ax = 0.02       # Length is about 5xjet_ax ~ magnitude > 0.01
jet_ay = 0.01       # Height is about 3xjet_ay ~ magnitude > 0.01
jet_az = 0.0062     # Width is about 4xjet_az ~ magnitude > 0.01
jet_scale = 5.0     # Scaling parameter for forces
jet_pitch = -45     # pitch angle for forces in degree
jet_rota = 11       # roation angle for jet field in degree
mpc_time_delay = 0.0    # time delay to start MPC
mpc_rom_time = 1e-3     # ROM time step: ROM is trained on every 10 LES time and each was dt=1e-4
mpc_time_horizon = 100   # Time horizon for control problem in ROM time steps
mpc_meas_freq = 0.025    # Time between consecutive new measurements
