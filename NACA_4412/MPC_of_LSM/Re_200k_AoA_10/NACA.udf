#include <fstream>
#include <iomanip>
#include <iostream>
#include <math.h>
#include <random>
#include <sstream>
#include <string>
#include <vector>

#ifdef __okl__
#include "NACA.oudf"
#include "my_drag.oudf"
#endif

static dfloat U_inf;
static dfloat AoA;

static dfloat AoA_rad;
static dfloat tdamp, rota;
static dfloat sposx, sposy, sposz;
static dfloat eposx, eposy, eposz;
static dfloat smthx, smthy;
static dfloat Lz;
static int nmode;
static dfloat tdt;
static std::vector<double> phase_current; // For h_i(z), size nmode
static std::vector<double> phase_next;    // For h_{i+1}(z), size nmode
static occa::memory o_phase_curr;
static occa::memory o_phase_next;
static int last_harmonic_index = -1;
static std::mt19937_64 rng(12345); // seed once (or seed per run)
static std::uniform_real_distribution<double> U01(0.0, 1.0);

static dfloat *dragvx, *dragvy, *dragvz;
static occa::memory o_dragvx, o_dragvy, o_dragvz;
static dfloat *dragpx, *dragpy, *dragpz;
static occa::memory o_dragpx, o_dragpy, o_dragpz;

static dfloat jet_xc, jet_yc, jet_zc;
static dfloat jet_ax, jet_ay, jet_az;
static dfloat jet_scale, jet_pitch, jet_rota;
static dfloat jet_input;

static dfloat mpc_time_delay;
static dfloat mpc_rom_time;
static dfloat mpc_time_horizon;
static dfloat mpc_meas_freq;
static std::vector<double> u_optimal;

struct Force {
  dfloat x;
  dfloat y;
  dfloat z;
};

static occa::memory o_ObsUbar, o_ObsVbar, o_ObsUprime, o_CtrlVprime;
static pointInterpolation_t *obsInterpolator = nullptr,
                            *ctrlInterpolator = nullptr;
static int obs_np = 0, ctrl_np = 0;

/* Viscous Drag and Pressure Drag */
Force compute_dragv(nrs_t *nrs, int nbID, const occa::memory &o_bID,
                    occa::memory &o_Sij, const dfloat scale) {
  mesh_t *mesh = nrs->meshV;
  Force dragv;

  if (o_dragvx.size() == 0) {
    dragvx = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragvy = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragvz = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    o_dragvx = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragvy = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragvz = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
  }

  dragvKernel(mesh->Nelements, nrs->fieldOffset, nbID, o_bID, mesh->o_sgeo,
              mesh->o_vmapM, mesh->o_EToB, nrs->o_mue, o_Sij, o_dragvx,
              o_dragvy, o_dragvz);

  o_dragvx.copyTo(dragvx);
  o_dragvy.copyTo(dragvy);
  o_dragvz.copyTo(dragvz);

  dragv.x = 0.0;
  dragv.y = 0.0;
  dragv.z = 0.0;
  for (dlong i = 0; i < mesh->Nelements; i++) {
    dragv.x += dragvx[i];
    dragv.y += dragvy[i];
    dragv.z += dragvz[i];
  }
  MPI_Allreduce(MPI_IN_PLACE, &dragv.x, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragv.y, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragv.z, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  dragv.x *= scale;
  dragv.y *= scale;
  dragv.z *= scale;

  return dragv;
}

Force compute_dragp(nrs_t *nrs, int nbID, const occa::memory &o_bID,
                    occa::memory &o_P, const dfloat scale) {
  mesh_t *mesh = nrs->meshV;
  Force dragp;

  if (o_dragpx.size() == 0) {
    dragpx = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragpy = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    dragpz = (dfloat *)calloc(mesh->Nelements, sizeof(dfloat));
    o_dragpx = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragpy = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
    o_dragpz = platform->device.malloc(mesh->Nelements, sizeof(dfloat));
  }

  dragpKernel(mesh->Nelements, nrs->fieldOffset, nbID, o_bID, mesh->o_sgeo,
              mesh->o_vmapM, mesh->o_EToB, o_P, o_dragpx, o_dragpy, o_dragpz);

  o_dragpx.copyTo(dragpx);
  o_dragpy.copyTo(dragpy);
  o_dragpz.copyTo(dragpz);

  dragp.x = 0.0;
  dragp.y = 0.0;
  dragp.z = 0.0;
  for (dlong i = 0; i < mesh->Nelements; i++) {
    dragp.x += dragpx[i];
    dragp.y += dragpy[i];
    dragp.z += dragpz[i];
  }
  MPI_Allreduce(MPI_IN_PLACE, &dragp.x, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragp.y, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  MPI_Allreduce(MPI_IN_PLACE, &dragp.z, 1, MPI_DFLOAT, MPI_SUM,
                platform->comm.mpiComm);
  dragp.x *= scale;
  dragp.y *= scale;
  dragp.z *= scale;

  return dragp;
}

void randomize_modes(std::vector<double> &phases) {
  for (int n = 0; n < nmode; ++n) {
    phases[n] = 2.0 * M_PI * U01(rng);
  }
}

inline double eval_h_theta_phased(const double theta,
                                  const std::vector<double> &phases) {
  double s = 0.0;
  for (int n = 0; n < nmode; ++n) {
    s += std::sin(n * theta + phases[n]);
  }
  return s;
}

void generate_tripping_forces(nrs_t *nrs, dfloat time, occa::memory o_FU) {
  auto *mesh = nrs->meshV;
  const int Np = mesh->Nlocal;
  const double Tu = tdamp;
  const double t_s = tdt;
  const double alpha = rota;
  const double x0 = sposx, y0 = sposy;
  const double z0 = sposz, z1 = eposz;

  // hoisted constants
  const double ca = std::cos(alpha);
  const double sa = std::sin(alpha);
  const double invSmx = 1.0 / smthx;
  const double invSmy = 1.0 / smthy;
  const double invLz = 1.0 / Lz;

  // time blending
  const int i = (int)std::floor(time / t_s);
  const double p = (time / t_s) - i;
  const double bt = (3.0 - 2.0 * p) * p * p; // 3p^2 - 2p^3

  if (i != last_harmonic_index) {
    // phase_current <- phase_next (device-to-device copy)
    o_phase_curr.copyFrom(o_phase_next, nmode * sizeof(dfloat));
    // phase_next <- new random (host -> device)
    if (platform->comm.mpiRank == 0)
      randomize_modes(phase_next);
    MPI_Bcast(phase_next.data(), nmode, MPI_DFLOAT, 0, platform->comm.mpiComm);
    o_phase_next.copyFrom(phase_next.data(), nmode * sizeof(dfloat));
    last_harmonic_index = i;
  }

  fill_FU_trip(mesh->Nlocal, nrs->fieldOffset, mesh->o_x, mesh->o_y, mesh->o_z,
               x0, y0, z0, z1, invSmx, invSmy, invLz, ca, sa, o_phase_curr,
               o_phase_next, nmode, Tu, bt, o_FU);

  if (nrs->isOutputStep) {
    const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
    auto o_FUy = nrs->o_FU.slice(1 * fieldOffsetByte, fieldOffsetByte);
    auto o_S1 = nrs->cds->o_S.slice(1 * fieldOffsetByte, fieldOffsetByte);
    o_S1.copyFrom(o_FUy);
  }
}

void set_jet_field(nrs_t *nrs, dfloat time, occa::memory o_FU){
  auto *mesh = nrs->meshV;
  const double cos_rota = std::cos(jet_rota * M_PI / 180.0);
  const double sin_rota = std::sin(jet_rota * M_PI / 180.0);
  const double cos_pitch = std::cos(jet_pitch * M_PI / 180.0);
  const double sin_pitch = std::sin(jet_pitch * M_PI / 180.0);

  const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
  auto o_S0 = nrs->cds->o_S.slice(0 * fieldOffsetByte, fieldOffsetByte);

  fill_FU_jet(mesh->Nlocal, nrs->fieldOffset, mesh->o_x, mesh->o_y, mesh->o_z,
              jet_xc, jet_yc, jet_zc, jet_ax, jet_ay, jet_az, jet_input,
              jet_scale, cos_rota, sin_rota, cos_pitch, sin_pitch, o_FU, o_S0);
}

void userf(nrs_t *nrs, dfloat time, occa::memory o_U, occa::memory o_FU) {
  generate_tripping_forces(nrs, time, o_FU);
  set_jet_field(nrs,time,o_FU);
}

// Reads x, y, z coordinates from file and fills vectors
void readGridFile(const std::string &filename, std::vector<dfloat> &x,
                  std::vector<dfloat> &y, std::vector<dfloat> &z, int mpiRank) {
  x.clear();
  y.clear();
  z.clear();

  if (mpiRank != 0) {
    // Non-root ranks: do nothing, vectors remain empty
    return;
  }

  // Only rank 0 executes this part:
  std::ifstream infile(filename);
  if (!infile.is_open()) {
    std::cerr << "Error opening file: " << filename << std::endl;
    return;
  }

  std::string line;
  int np = 0;

  // Read number of points
  if (std::getline(infile, line)) {
    std::istringstream iss(line);
    iss >> np;
  }

  x.reserve(np);
  y.reserve(np);
  z.reserve(np);

  // Read coordinates
  while (std::getline(infile, line)) {
    std::istringstream iss(line);
    dfloat xi, yi, zi;
    if (iss >> xi >> yi >> zi) {
      x.push_back(xi);
      y.push_back(yi);
      z.push_back(zi);
    }
  }
}

void setupInterpolators(nrs_t *nrs, pointInterpolation_t *&obsInterpolator,
                        occa::memory &o_ObsUbar, occa::memory &o_ObsVbar,
                        occa::memory &o_ObsUprime, int &obs_np,
                        pointInterpolation_t *&ctrlInterpolator,
                        occa::memory &o_CtrlVprime, int &ctrl_np) {

  static std::vector<dfloat> obs_x, obs_y, obs_z;
  static std::vector<dfloat> ctrl_x, ctrl_y, ctrl_z;

  // Read grid files only once
  if (!obsInterpolator) {
    readGridFile("observation_grid.txt", obs_x, obs_y, obs_z,
                 platform->comm.mpiRank);
    obs_np = obs_x.size();
    o_ObsUbar = platform->device.malloc(obs_np, sizeof(dfloat));
    o_ObsVbar = platform->device.malloc(obs_np, sizeof(dfloat));
    o_ObsUprime = platform->device.malloc(obs_np, sizeof(dfloat));
    obsInterpolator = new pointInterpolation_t(nrs);
    obsInterpolator->setPoints(obs_np, obs_x.data(), obs_y.data(),
                               obs_z.data());
    obsInterpolator->find();
  }
  if (!ctrlInterpolator) {
    readGridFile("control_grid.txt", ctrl_x, ctrl_y, ctrl_z,
                 platform->comm.mpiRank);
    ctrl_np = ctrl_x.size();
    o_CtrlVprime = platform->device.malloc(ctrl_np, sizeof(dfloat));
    ctrlInterpolator = new pointInterpolation_t(nrs);
    ctrlInterpolator->setPoints(ctrl_np, ctrl_x.data(), ctrl_y.data(),
                                ctrl_z.data());
    ctrlInterpolator->find();
  }
}

void interpolateObsGrid(nrs_t *nrs, dfloat time, int tstep,
                        occa::memory o_mean_vx, occa::memory o_mean_vy) {
  
  static bool initialized = false;
  if (!initialized) {
    // Interpolate U_bar fluctuation
    obsInterpolator->eval(1, nrs->fieldOffset, o_mean_vx, obs_np, o_ObsUbar);
    // Interpolate V_bar fluctuation
    obsInterpolator->eval(1, nrs->fieldOffset, o_mean_vy, obs_np, o_ObsVbar);
    initialized = true;
  }
  // Interpolate velocity
  const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);

  // Interpolate velocity fluctuation (if available)
  occa::memory ux_prime =
      platform->device.malloc(nrs->fieldOffset, sizeof(dfloat));
  occa::memory o_ux = nrs->o_U.slice(0 * fieldOffsetByte, fieldOffsetByte);
  platform->linAlg->axpbyz(nrs->meshV->Nlocal, 1.0, o_ux, -1.0, o_mean_vx,
                           ux_prime);
  obsInterpolator->eval(1, nrs->fieldOffset, ux_prime, obs_np, o_ObsUprime);

  if (platform->comm.mpiRank == 0) {
    std::vector<dfloat> ObsUbar(obs_np);
    std::vector<dfloat> ObsVbar(obs_np);
    std::vector<dfloat> ObsUprime(obs_np);
    o_ObsUbar.copyTo(ObsUbar.data());
    o_ObsVbar.copyTo(ObsVbar.data());
    o_ObsUprime.copyTo(ObsUprime.data());

    std::ofstream fout("observation_grid_data.txt",
                       std::ios::trunc); // 'replace' mode

    printf("Writing new LSM data into observation_grid_data.txt ... ");
    fout << "#time = " << std::setprecision(7) << std::scientific << time
         << std::endl;
    fout << "#  <u>  <v>  u_prime" << std::endl;

    for (int i = 0; i < obs_np; ++i) {
      fout << std::setw(15) << std::setprecision(8) << std::scientific
           << ObsUbar[i] << " " << std::setw(15) << std::setprecision(8)
           << std::scientific << ObsVbar[i] << " " << std::setw(15)
           << std::setprecision(8) << std::scientific << ObsUprime[i]
           << std::endl;
    }
    fout.close();
    printf("Done \n");
  }
}

void interpolateCtrlGrid(nrs_t *nrs, dfloat time, int tstep,
                         dfloat last_u_optimal, occa::memory o_mean_vy) {

  // Interpolate velocity
  const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);

  // Interpolate vertical velocity fluctuation
  occa::memory vy_prime =
      platform->device.malloc(nrs->fieldOffset, sizeof(dfloat));
  occa::memory o_vy = nrs->o_U.slice(1 * fieldOffsetByte, fieldOffsetByte);
  platform->linAlg->axpbyz(nrs->meshV->Nlocal, 1.0, o_vy, -1.0, o_mean_vy,
                           vy_prime);
  ctrlInterpolator->eval(1, nrs->fieldOffset, vy_prime, ctrl_np, o_CtrlVprime);

  if (platform->comm.mpiRank == 0) {
    std::vector<dfloat> CtrlVprime(ctrl_np);
    o_CtrlVprime.copyTo(CtrlVprime.data());

    std::ofstream fout("control_grid_data.txt", std::ios::trunc);

    printf("Writing new LSM data into control_grid_data.txt ... ");
    fout << "#time = " << std::setprecision(7) << std::scientific << time
         << std::endl;
    fout << std::setw(15) << std::setprecision(8) << std::scientific
         << last_u_optimal << std::endl;
    fout << "#  v_prime " << std::endl;

    for (int i = 0; i < ctrl_np; ++i) {
      fout << std::setw(15) << std::setprecision(8) << std::scientific
           << CtrlVprime[i] << std::endl;
    }
    fout.close();
    printf("Done \n");
  }
}

void solveQPandBroadcast(int n_mpc_rom, std::vector<double>& u_optimal) {
  // Only resize if size might change
  if (u_optimal.size() != n_mpc_rom) {
      u_optimal.resize(n_mpc_rom);
  }
  if (platform->comm.mpiRank == 0) {
      int ret = system("python MPC_of_LSM_LQT.py");
      if (ret != 0) {
          std::cerr << "Error: Python script failed with code " << ret << std::endl;
          std::exit(EXIT_FAILURE);
      }
      std::ifstream fin("u_optimal.txt");
      if (!fin.is_open()) {
          std::cerr << "Error opening file: u_optimal.txt" << std::endl;
          std::exit(EXIT_FAILURE);
      }
      for (int i = 0; i < n_mpc_rom; ++i) {
          if (!(fin >> u_optimal[i])) {
              std::cerr << "Error reading data at line " << (i + 1) << std::endl;
              std::exit(EXIT_FAILURE);
          }
      }
      fin.close();
  }
  MPI_Bcast(u_optimal.data(), n_mpc_rom, MPI_DOUBLE, 0, platform->comm.mpiComm);
}

void MPC_of_LSM(nrs_t *nrs, dfloat time, int tstep){
  static bool initialized = false;
  static double last_mpc_update_time;
  static std::vector<double> u_optimal;
  static occa::memory o_mean_vx, o_mean_vy;

  if (!initialized) {
    const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
    o_mean_vx = nrs->cds->o_S.slice(2 * fieldOffsetByte, fieldOffsetByte);
    o_mean_vy = nrs->cds->o_S.slice(3 * fieldOffsetByte, fieldOffsetByte);
    mpc_time_delay += time; // first allowed MPC update
    last_mpc_update_time = mpc_time_delay;
    u_optimal.assign(mpc_time_horizon, 0.0);
    initialized = true;
  }

  if (time < mpc_time_delay) {
    jet_input = 0.0;
    if (platform->comm.mpiRank == 0) {
      std::ofstream fout("jet_input.txt", std::ios::app);
      // First three columns: width 6, default notation
      fout << std::setw(6) << tstep << " ";
      fout << std::setw(6) << std::setprecision(4) << std::scientific << time
           << " ";
      fout << std::setw(6) << std::setprecision(4) << jet_input << std::endl;
      fout.close();
    }
    return;
  }

  if (time >= last_mpc_update_time) {
    interpolateObsGrid(nrs, time, tstep, o_mean_vx, o_mean_vy);
    interpolateCtrlGrid(nrs, time, tstep, jet_input, o_mean_vy);
    solveQPandBroadcast(mpc_time_horizon, u_optimal);
    last_mpc_update_time += mpc_meas_freq; // set next allowed MPC update time
  }
  // Compute control index for current time
  double time_since_mpc = time - last_mpc_update_time + mpc_meas_freq;
  int ctrl_idx = static_cast<int>(time_since_mpc / mpc_rom_time);
  if (ctrl_idx >= mpc_time_horizon) ctrl_idx = mpc_time_horizon - 1;

  jet_input = u_optimal[ctrl_idx];
  if (platform->comm.mpiRank == 0) {
    printf("%d %15.8e ctrl_idx: %d u_optimal: %15.8e jet_input: %15.8e \n", tstep, time, ctrl_idx,
      u_optimal[ctrl_idx], jet_input);
    std::ofstream fout("jet_input.txt", std::ios::app);
    // First three columns: width 6, default notation
    fout << std::setw(6) << tstep << " ";
    fout << std::setw(6) << std::setprecision(4) << std::scientific << time
         << " ";
    fout << std::setw(6) << std::setprecision(4) << jet_input << std::endl;
    fout.close();
  }
}

/* UDF Functions */

void UDF_LoadKernels(occa::properties &kernelInfo) {
  kernelInfo["defines/p_U_inf"] = U_inf;
  kernelInfo["defines/p_AoA"] = AoA;
  kernelInfo["defines/p_pi"] = M_PI;
}

void UDF_Setup0(MPI_Comm comm, setupAide &options) {

  platform->par->extract("casedata", "U_inf", U_inf);
  platform->par->extract("casedata", "AoA", AoA);

  platform->par->extract("casedata", "TDAMP", tdamp);
  platform->par->extract("casedata", "SPOSX", sposx);
  platform->par->extract("casedata", "SPOSY", sposy);
  platform->par->extract("casedata", "SPOSZ", sposz);
  platform->par->extract("casedata", "EPOSX", eposx);
  platform->par->extract("casedata", "EPOSY", eposy);
  platform->par->extract("casedata", "EPOSZ", eposz);
  platform->par->extract("casedata", "SMTHX", smthx);
  platform->par->extract("casedata", "SMTHY", smthy);
  platform->par->extract("casedata", "ROTA", rota);
  platform->par->extract("casedata", "NMODE", nmode);
  platform->par->extract("casedata", "TDT", tdt);

  platform->par->extract("casedata","jet_xc", jet_xc);
  platform->par->extract("casedata","jet_yc", jet_yc);
  platform->par->extract("casedata","jet_zc", jet_zc);
  platform->par->extract("casedata","jet_ax", jet_ax);
  platform->par->extract("casedata","jet_ay", jet_ay);
  platform->par->extract("casedata","jet_az", jet_az);
  platform->par->extract("casedata","jet_scale", jet_scale);
  platform->par->extract("casedata","jet_pitch", jet_pitch);
  platform->par->extract("casedata","jet_rota", jet_rota);

  platform->par->extract("casedata","mpc_time_delay", mpc_time_delay);
  platform->par->extract("casedata","mpc_rom_time", mpc_rom_time);
  platform->par->extract("casedata","mpc_time_horizon", mpc_time_horizon);
  platform->par->extract("casedata","mpc_meas_freq", mpc_meas_freq);

  *((double *)nek::scPtr(1)) = U_inf;
  *((double *)nek::scPtr(2)) = AoA;
}

void UDF_Setup(nrs_t *nrs) {
  mesh_t *mesh = nrs->meshV;
  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    for (int i = 0; i < mesh->Nlocal; ++i) {
      nrs->U[i + 0 * nrs->fieldOffset] = U_inf * cos(AoA * M_PI / 180.0);
      nrs->U[i + 1 * nrs->fieldOffset] = U_inf * sin(AoA * M_PI / 180.0);
      nrs->U[i + 2 * nrs->fieldOffset] = 0.0;
    }
  }
  // Tripping setup
  Lz = std::abs(eposz - sposz);
  AoA_rad = AoA * M_PI / 180.0;
  phase_current.resize(nmode, 0.0);
  phase_next.resize(nmode, 0.0);
  if (platform->comm.mpiRank == 0) {
    randomize_modes(phase_current);
    randomize_modes(phase_next);
  }
  MPI_Bcast(phase_current.data(), nmode, MPI_DFLOAT, 0, platform->comm.mpiComm);
  MPI_Bcast(phase_next.data(), nmode, MPI_DFLOAT, 0, platform->comm.mpiComm);

  o_phase_curr = platform->device.malloc(nmode, sizeof(dfloat));
  o_phase_next = platform->device.malloc(nmode, sizeof(dfloat));
  o_phase_curr.copyFrom(phase_current.data());
  o_phase_next.copyFrom(phase_next.data());
  udf.uEqnSource = &userf;

  // Time averaging setup
  tavg::setup(nrs);

  // Interpolation setup
  setupInterpolators(nrs, obsInterpolator, o_ObsUbar, o_ObsVbar, o_ObsUprime,
                     obs_np, ctrlInterpolator, o_CtrlVprime, ctrl_np);
}

void UDF_ExecuteStep(nrs_t *nrs, dfloat time, int tstep) {
  // compute drag
  std::vector<int> bidWall = {3};
  occa::memory o_bidWall =
      platform->device.malloc(bidWall.size() * sizeof(int), bidWall.data());

  // C = F/(.5 rho U^2 * A) = 2*F, A=c*Lz, rho=1, U=U_inf
  const dfloat scale = 1.0;
  auto o_Sij = platform->device.malloc(2 * nrs->NVfields * nrs->fieldOffset,
                                       sizeof(dfloat));
  postProcessing::strainRate(nrs, true, o_Sij); // "false" is correct

  Force dragv = compute_dragv(nrs, bidWall.size(), o_bidWall, o_Sij, scale);
  Force dragp = compute_dragp(nrs, bidWall.size(), o_bidWall, nrs->o_P, scale);
  o_Sij.free();

  Force drag;
  drag.x = dragp.x + dragv.x;
  drag.y = dragp.y + dragv.y;
  drag.z = dragp.z + dragv.z;

  double F_drag = drag.x * cos(AoA_rad) + drag.y * sin(AoA_rad);
  double F_lift = -drag.x * sin(AoA_rad) + drag.y * cos(AoA_rad);

  double Cd = F_drag / (0.5 * Lz);
  double Cl = F_lift / (0.5 * Lz);

  if (platform->comm.mpiRank == 0) {

    std::ofstream drag_file("drag.txt", std::ios::app);
    std::ofstream lift_file("lift.txt", std::ios::app);
    std::ofstream dragz_file("dragz.txt", std::ios::app);
    std::ofstream forces_file("forces.txt", std::ios::app);

    printf("%d %15.8e %15.8e %15.8e %15.8e dragx(rs)\n", tstep, time, drag.x,
           dragp.x, dragv.x);
    printf("%d %15.8e %15.8e %15.8e %15.8e dragy(rs)\n", tstep, time, drag.y,
           dragp.y, dragv.y);
    printf("%d %15.8e %15.8e %15.8e %15.8e dragz(rs)\n", tstep, time, drag.z,
           dragp.z, dragv.z);
    printf("%d %15.8e %15.8e %15.8e %15.8e %15.8e \n", tstep, time, F_drag,
           F_lift, Cd, Cl);
    
    // Set field width and precision
    const int width_int = 6;      // for tstep
    const int width_float = 15;   // for floating point numbers

    // Write drag.txt
    if (drag_file.is_open()) {
        drag_file << std::setw(width_int) << tstep << " "
                  << std::setw(width_float) << std::setprecision(8) << std::scientific << time << " "
                  << std::setw(width_float) << drag.x << " "
                  << std::setw(width_float) << dragp.x << " "
                  << std::setw(width_float) << dragv.x << "\n";
        drag_file.close();
    }

    // Write lift.txt
    if (lift_file.is_open()) {
        lift_file << std::setw(width_int) << tstep << " "
                  << std::setw(width_float) << std::setprecision(8) << std::scientific << time << " "
                  << std::setw(width_float) << drag.y << " "
                  << std::setw(width_float) << dragp.y << " "
                  << std::setw(width_float) << dragv.y << "\n";
        lift_file.close();
    }

    // Write dragz.txt
    if (dragz_file.is_open()) {
        dragz_file << std::setw(width_int) << tstep << " "
                   << std::setw(width_float) << std::setprecision(8) << std::scientific << time << " "
                   << std::setw(width_float) << drag.z << " "
                   << std::setw(width_float) << dragp.z << " "
                   << std::setw(width_float) << dragv.z << "\n";
        dragz_file.close();
    }

    // Write forces.txt
    if (forces_file.is_open()) {
        forces_file << std::setw(width_int) << tstep << " "
                    << std::setw(width_float) << std::setprecision(8) << std::scientific << time << " "
                    << std::setw(width_float) << F_drag << " "
                    << std::setw(width_float) << F_lift << " "
                    << std::setw(width_float) << Cd << " "
                    << std::setw(width_float) << Cl << "\n";
        forces_file.close();
    }
    
  }

  // tavg::run(time);
  MPC_of_LSM(nrs, time, tstep);

  if (nrs->isOutputStep) {
    const auto fieldOffsetByte = nrs->fieldOffset * sizeof(dfloat);
    auto o_S0 = nrs->cds->o_S.slice(0 * fieldOffsetByte, fieldOffsetByte);
    postProcessing::Qcriterion(nrs, o_S0);
  }
}
