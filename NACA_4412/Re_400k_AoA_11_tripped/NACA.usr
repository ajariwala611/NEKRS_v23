!-----------------------------------------------------------------------
      subroutine usrdat0()
        include 'SIZE'
        include 'TOTAL'
  
        real           xstart, U_inf
        COMMON /CASEDATA/ xstart, U_inf
  
        COMMON /NRSSCPTR/ nrs_scptr(3)
        integer*8         nrs_scptr
  
        nrs_scptr(1) = loc(xstart)
        nrs_scptr(2) = loc(U_inf)
  
        return
        end
!-----------------------------------------------------------------------
      subroutine set_obj  ! define objects for surface integrals

            include 'SIZE'
            include 'TOTAL'

            integer e,f,eg

            nobj = 1
            iobj = 0
            do ii=nhis+1,nhis+nobj
            iobj = iobj+1
            hcode(10,ii) = 'I'
            hcode( 1,ii) = 'F'
            hcode( 2,ii) = 'F'
            hcode( 3,ii) = 'F'
            lochis(1,ii) = iobj
            enddo
            nhis = nhis + nobj

            if (maxobj.lt.nobj) call exitti('increase maxobj in SIZE$',nobj)

            nxyz  = nx1*ny1*nz1
            nface = 2*ndim

            do e=1,nelv
            do f=1,nface
            if (boundaryID(f,e) .eq. 3) then
                  iobj  = 1
                  if (iobj.gt.0) then
                        nmember(iobj) = nmember(iobj) + 1
                        mem = nmember(iobj)
                        eg  = lglel(e)
                        object(iobj,mem,1) = eg
                        object(iobj,mem,2) = f
                  endif
            endif
            enddo
            enddo

      return
      end
